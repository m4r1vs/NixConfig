+bool is_escape_key(uint32_t keycode) {
+    if (keycode == KEY_ESC)
+        return true;
+    if (!g_pInputManager)
+        return false;
+    for (const auto& kb : g_pInputManager->m_keyboards) {
+        if (!kb || !kb->m_enabled)
+            continue;
+        xkb_state* st = kb->m_xkbSymState ? kb->m_xkbSymState : kb->m_xkbState;
+        if (!st)
+            continue;
+        if (xkb_state_key_get_one_sym(st, keycode + 8) == XKB_KEY_Escape)
+            return true;
+    }
+    return false;
+}
