+static void on_key(IKeyboard::SKeyEvent e, Event::SCallbackInfo& info) {
+    if (e.state == WL_KEYBOARD_KEY_STATE_RELEASED) {
+        if (swallowed_esc_keycode.has_value() && *swallowed_esc_keycode == e.keycode) {
+            swallowed_esc_keycode.reset();
+            info.cancelled = true;
+        }
+        return;
+    }
+
+    if (ht_manager == nullptr || !ht_manager->has_active_view())
+        return;
+
+    if (e.state == WL_KEYBOARD_KEY_STATE_PRESSED && is_escape_key(e.keycode)) {
+        swallowed_esc_keycode = e.keycode;
+        ht_manager->hide_all_views(true);
+        info.cancelled = true;
+    }
 }
 
