+
+constexpr uint32_t VERTICAL_VEL_WINDOW_MS = 100;
+constexpr float VERTICAL_FLICK_VEL = 0.0012f;
+
+class CHTVerticalGesture : public ITrackpadGesture {
+  public:
+    void begin(const STrackpadGestureBegin& e) override {
+        tracking = false;
+        samples.clear();
+        if (ht_manager == nullptr || !e.swipe)
+            return;
+
+        const PHTVIEW view = ht_manager->get_view_from_cursor();
+        if (view == nullptr || view->layout == nullptr)
+            return;
+
+        if (!view->active) {
+            if (e.direction != TRACKPAD_GESTURE_DIR_UP)
+                return;
+            started_open = false;
+            progress = 0.f;
+            view->begin_gesture_open();
+            view->layout->close_open_lerp(0.f);
+            tracking = true;
+        } else {
+            started_open = true;
+            progress = view->layout->current_open_progress();
+            view->closing = false;
+            view->active = true;
+            tracking = true;
+        }
+    }
+
+    void update(const STrackpadGestureUpdate& e) override {
+        if (!tracking || ht_manager == nullptr || !e.swipe)
+            return;
+
+        const PHTVIEW view = ht_manager->get_view_from_cursor();
+        if (view == nullptr || view->layout == nullptr) {
+            tracking = false;
+            return;
+        }
+
+        const float open_dist =
+            std::max(40.f, HTConfig::value<Config::FLOAT>("gestures:open_distance"));
+        const float delta_p = static_cast<float>(-e.swipe->delta.y) / open_dist;
+        progress = std::clamp(progress + delta_p, 0.f, 1.f);
+
+        samples.push_back({e.swipe->timeMs, delta_p});
+        while (samples.size() > 1
+               && static_cast<int64_t>(e.swipe->timeMs) - samples.front().timeMs
+                   > VERTICAL_VEL_WINDOW_MS) {
+            samples.pop_front();
+        }
+
+        view->layout->close_open_lerp(progress);
+        if (const PHLMONITOR mon = view->get_monitor()) {
+            g_pHyprRenderer->damageMonitor(mon);
+            g_pCompositor->scheduleFrameForMonitor(mon);
+        }
+    }
+
+    void end(const STrackpadGestureEnd& e) override {
+        if (!tracking)
+            return;
+        tracking = false;
+
+        if (ht_manager == nullptr)
+            return;
+        const PHTVIEW view = ht_manager->get_view_from_cursor();
+        if (view == nullptr)
+            return;
+
+        float vel = 0.f;
+        if (samples.size() >= 2) {
+            const uint32_t dt = samples.back().timeMs > samples.front().timeMs
+                ? (samples.back().timeMs - samples.front().timeMs)
+                : 1;
+            float sum = 0.f;
+            for (size_t i = 1; i < samples.size(); ++i)
+                sum += samples[i].deltaP;
+            vel = sum / static_cast<float>(dt);
+        }
+        samples.clear();
+
+        bool should_open = false;
+        if (e.swipe && e.swipe->cancelled) {
+            should_open = started_open;
+        } else if (vel > VERTICAL_FLICK_VEL && progress > 0.08f) {
+            should_open = true;
+        } else if (vel < -VERTICAL_FLICK_VEL && progress < 0.92f) {
+            should_open = false;
+        } else {
+            should_open = progress >= 0.45f;
+        }
+
+        if (should_open) {
+            view->show(false);
+        } else {
+            // If user only peeked from closed and pulled back down, keep active workspace;
+            // if closing an already-open overview, honor exit_on_hovered.
+            view->hide(false, !started_open);
+        }
+    }
+
+  private:
+    bool tracking = false;
+    bool started_open = false;
+    float progress = 0.f;
+    std::deque<VerticalSample> samples;
+};
