+namespace {
+WORKSPACEID get_neighbor_workspace_id(
+    const PHLMONITOR& monitor,
+    WORKSPACEID base_id,
+    int step,
+    bool use_r
+) {
+    if (monitor == nullptr || step == 0 || base_id == WORKSPACE_INVALID)
+        return WORKSPACE_INVALID;
+
+    if (!use_r) {
+        std::vector<WORKSPACEID> monitor_ws_ids;
+        for (const PHLWORKSPACE& ws : g_pCompositor->getWorkspacesCopy()) {
+            if (ws == nullptr || ws->m_isSpecialWorkspace || ws->m_monitor != monitor)
+                continue;
+            monitor_ws_ids.push_back(ws->m_id);
+        }
+        std::sort(monitor_ws_ids.begin(), monitor_ws_ids.end());
+
+        const auto it = std::find(monitor_ws_ids.begin(), monitor_ws_ids.end(), base_id);
+        if (it == monitor_ws_ids.end())
+            return WORKSPACE_INVALID;
+
+        const ssize_t idx = std::distance(monitor_ws_ids.begin(), it) + step;
+        if (idx < 0 || idx >= static_cast<ssize_t>(monitor_ws_ids.size()))
+            return WORKSPACE_INVALID;
+        return monitor_ws_ids[idx];
+    }
+
+    std::set<WORKSPACEID> invalid_ws_ids;
+    std::vector<WORKSPACEID> named_ws_ids;
+    for (const PHLWORKSPACE& ws : g_pCompositor->getWorkspacesCopy()) {
+        if (ws == nullptr)
+            continue;
+        if (ws->m_isSpecialWorkspace || ws->m_monitor != monitor) {
+            invalid_ws_ids.insert(ws->m_id);
+        } else if (ws->m_id < 0) {
+            named_ws_ids.push_back(ws->m_id);
+        }
+    }
+    for (const auto& rule : Config::workspaceRuleMgr()->getAllWorkspaceRules()) {
+        const auto rule_mon = g_pCompositor->getMonitorFromString(rule.m_monitor);
+        if (rule_mon && rule_mon->m_id != monitor->m_id)
+            invalid_ws_ids.insert(rule.m_workspaceId);
+    }
+    std::sort(named_ws_ids.begin(), named_ws_ids.end());
+
+    if (base_id < 0) {
+        const auto it = std::find(named_ws_ids.begin(), named_ws_ids.end(), base_id);
+        if (it == named_ws_ids.end())
+            return WORKSPACE_INVALID;
+
+        const ssize_t target_idx = std::distance(named_ws_ids.begin(), it) + step;
+        if (target_idx < 0)
+            return WORKSPACE_INVALID;
+        if (target_idx < static_cast<ssize_t>(named_ws_ids.size()))
+            return named_ws_ids[target_idx];
+
+        ssize_t rem = target_idx - static_cast<ssize_t>(named_ws_ids.size()) + 1;
+        WORKSPACEID cur = 0;
+        while (rem > 0 && cur < INT32_MAX) {
+            ++cur;
+            if (!invalid_ws_ids.contains(cur))
+                --rem;
+        }
+        return rem == 0 ? cur : WORKSPACE_INVALID;
+    }
+
+    if (step > 0) {
+        WORKSPACEID cur = base_id;
+        int rem = step;
+        while (rem > 0 && cur < INT32_MAX) {
+            ++cur;
+            if (!invalid_ws_ids.contains(cur))
+                --rem;
+        }
+        return rem == 0 ? cur : WORKSPACE_INVALID;
+    }
+
+    WORKSPACEID cur = base_id;
+    int rem = -step;
+    while (rem > 0 && cur > 1) {
+        --cur;
+        if (!invalid_ws_ids.contains(cur))
+            --rem;
+    }
+    if (rem == 0)
+        return cur;
+    if (static_cast<size_t>(rem) <= named_ws_ids.size())
+        return named_ws_ids[named_ws_ids.size() - rem];
+    return WORKSPACE_INVALID;
+}
