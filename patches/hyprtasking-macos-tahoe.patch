+struct ScopedConfigBoolOverride {
+    bool* bool_ptr = nullptr;
+    Config::INTEGER* int_ptr = nullptr;
+    bool saved_bool = false;
+    Config::INTEGER saved_int = 0;
+
+    ScopedConfigBoolOverride(const std::string& name, bool value) {
+        if (!Config::mgr())
+            return;
+        const auto reply = Config::mgr()->getConfigValue(name);
+        if (reply.dataptr == nullptr || *reply.dataptr == nullptr || reply.type == nullptr)
+            return;
+        if (*reply.type == typeid(bool)) {
+            bool_ptr = static_cast<bool*>(*reply.dataptr);
+            saved_bool = *bool_ptr;
+            *bool_ptr = value;
+        } else if (*reply.type == typeid(Config::INTEGER)) {
+            int_ptr = static_cast<Config::INTEGER*>(*reply.dataptr);
+            saved_int = *int_ptr;
+            *int_ptr = value ? 1 : 0;
+        }
+    }
+
+    ~ScopedConfigBoolOverride() {
+        if (bool_ptr != nullptr)
+            *bool_ptr = saved_bool;
+        else if (int_ptr != nullptr)
+            *int_ptr = saved_int;
+    }
+
+    ScopedConfigBoolOverride(const ScopedConfigBoolOverride&) = delete;
+    ScopedConfigBoolOverride& operator=(const ScopedConfigBoolOverride&) = delete;
+};
